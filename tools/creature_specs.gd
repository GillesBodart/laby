static func get_spec(id: String) -> Dictionary:
	var rig := Catalog.rig_of(id)
	var out: Dictionary = RIG.get(rig, {}).duplicate()
	var own: Dictionary = SPECS.get(id, {})
	var fam := String(Catalog.def(id).family)
	if rig == "quadruped":
		out.merge(BEAR if fam == "bears" else (CANINE if fam == "canines" else {}), true)
	out.merge(own, true)
	out.rig = rig
	out.id = id
	return out
