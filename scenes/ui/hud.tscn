[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/hud/hud.gd" id="1_hud"]
[ext_resource type="StyleBox" path="res://resources/ui/hud_frame.tres" id="2_frame"]

[node name="HUD" type="CanvasLayer"]
